# Copy this file to ".env" (which is git-ignored) and put your real keys there —
# NOT in this template, which is committed to git.
#
# With ANTHROPIC_API_KEY set, JARVIS's brain uses the (faster) anthropic SDK.
# Leave it unset to use the free claude-CLI path (your Claude Code subscription).
ANTHROPIC_API_KEY=

# Optional: ElevenLabs voice. With this set (plus elevenlabs_voice_id in
# config.toml), JARVIS speaks with an ElevenLabs voice instead of edge-tts.
ELEVENLABS_API_KEY=
